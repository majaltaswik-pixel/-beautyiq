{
  "name": "beautyiq-revenue-system",
  "version": "1.0.0",
  "description": "AI-native Revenue Operating System for Shopify skincare & beauty brands",
  "main": "dist/main.js",
  "scripts": {
    "build": "npm install --include=dev && npx --yes --package typescript@^5.3.3 -- tsc && (cd frontend && npm install && npx --yes --package vite@^5.0.12 -- vite build)",
    "start": "node dist/main.js",
    "dev": "ts-node-dev --respawn --transpile-only main.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint 'src/**/*.ts'",
    "test": "jest",
    "migrate": "node scripts/migrate.js"
  },
  "dependencies": {
    "@shopify/app-bridge-react": "^3.7.0",
    "@shopify/shopify-api": "^11.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "helmet": "^7.1.0",
    "ioredis": "^5.4.0",
    "morgan": "^1.10.0",
    "pg": "^8.12.0",
    "@types/node": "^20.19.43",
    "stripe": "^22.2.1",
    "typescript": "^5.3.3",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.11",
    "@types/morgan": "^1.9.9",
    "@types/pg": "^8.10.9",
    "@types/uuid": "^9.0.7",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "ts-node-dev": "^2.0.0"
  }
}
